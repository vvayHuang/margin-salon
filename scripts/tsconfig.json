{
  // Nuxt 產生的 tsconfig 只涵蓋 app／server／shared，掃不到這裡。
  // 同步腳本是純 Node 程式，型別自成一套，所以獨立一份，由 `npm run typecheck:scripts` 檢查。
  "compilerOptions": {
    "strict": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
