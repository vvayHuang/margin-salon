{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nuxt-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "wrangler-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false",
        "npx",
        "--yes",
        "wrangler",
        "dev",
        "--ip",
        "127.0.0.1",
        "--port",
        "8787"
      ],
      "port": 8787
    }
  ]
}
